# Copy to backend/.env and tweak. All values are optional; defaults live in app/config.py.

# Round-based game loop
ROUND_SECONDS=20              # round 1; default for new rooms, the host can change it
ROUND_DECREMENT_SECONDS=0     # each later round is this much shorter; host can change it
ROUNDS_PER_GAME=5             # default for new rooms; the host can pick 5 or 10
INTERMISSION_SECONDS=4
GAME_SECONDS=130              # minimum game cap; grows to fit the host's schedule

# Rooms
JOIN_CODE_LENGTH=4            # letters only, so a code survives being read out loud
MAX_PLAYERS_PER_ROOM=12
EMPTY_ROOM_GRACE_SECONDS=60   # a room nobody is connected to is destroyed after this
ROOM_REAP_INTERVAL_SECONDS=5  # how often the reaper looks

# Capture / upload limits
CAPTURE_INTERVAL_MS=500        # advisory: pushed to the client, which uses it as its tick
MIN_FRAME_INTERVAL_MS=250      # enforced server-side; faster frames are skipped
MAX_FRAME_BYTES=2097152        # 2 MiB

# Frame processing
# dummy  = label from the frame's SHA-256. Deterministic, ignores the actual face. No key needed.
# gemini = real vision classification against the prompt vocabulary. Needs GEMINI_API_KEY.
# custom = your own model; app/processing/custom.py is still a stub that fails every frame.
PROCESSOR=dummy                # dummy | gemini | custom
WORKER_COUNT=2
QUEUE_MAXSIZE=64
GEMINI_VISION_MODEL=gemini-2.5-flash   # used by PROCESSOR=gemini

# Client-reported vitals (POST /api/rooms/{id}/vitals)
# Stored on the player and broadcast to the room; never an input to scoring, because the
# numbers come from the player's own browser and the server cannot verify them.
VITALS_ENABLED=true
MAX_VITALS_FIELDS=24           # cap per report: untrusted input that lands in every snapshot

# Round narration ("Uncle Damage")
# Both halves are optional and degrade independently:
#   no GEMINI_API_KEY     -> the prompt text from prompts.py is spoken as written
#   no ELEVENLABS_API_KEY -> the line is published as text, round.audio_id stays null
#   neither               -> no narration at all; /api/health shows voice.enabled=false
VOICE_ENABLED=true
VOICE_TTL_SECONDS=1800         # generated mp3s are reaped from MEDIA_DIR/voice after this

# --- third-party keys (leave unset to disable the feature that needs them) ---
# GEMINI_API_KEY=              # PROCESSOR=gemini, and Gemini-written voice lines
# ELEVENLABS_API_KEY=          # text-to-speech for the round narration

# Media storage
MEDIA_DIR=.media
MEDIA_TTL_SECONDS=900

# CORS (vite dev server)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
