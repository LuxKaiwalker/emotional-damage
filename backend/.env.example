# Copy to backend/.env and tweak. All values are optional; defaults live in app/config.py.

# Round-based game loop
ROUND_SECONDS=20
ROUNDS_PER_GAME=3
INTERMISSION_SECONDS=4

# Capture / upload limits
CAPTURE_INTERVAL_MS=500        # advisory: pushed to the client, which uses it as its tick
MIN_FRAME_INTERVAL_MS=250      # enforced server-side; faster frames are skipped
MAX_FRAME_BYTES=2097152        # 2 MiB

# Frame processing
PROCESSOR=dummy                # dummy | custom
WORKER_COUNT=2
QUEUE_MAXSIZE=64

# Media storage
MEDIA_DIR=.media
MEDIA_TTL_SECONDS=900

# CORS (vite dev server)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
