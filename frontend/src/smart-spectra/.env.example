# Copy to frontend/.env (vite's dotenv) or export before `npm run spectra`.
# server.js reads these via "dotenv/config" at startup.

# Required. The process throws on boot without it.
SMARTSPECTRA_API_KEY=

# Required. verifyClient does an exact string match on the browser's Origin header, so
# every connection is rejected with 403 while this is unset -- including from localhost.
# Must be the origin the page is served from, scheme and port included, with no trailing slash.
WEB_ORIGIN=http://localhost:5173

# Port the sidecar listens on. Must match VITE_SPECTRA_WS_URL in frontend/.env.
PORT=3001

# PROCESSOR=presage: where expression readings go, and the shared token. Must match
# PRESAGE_INGEST_TOKEN in backend/.env. Without it the sidecar serves vitals only.
BACKEND_URL=http://127.0.0.1:8000
PRESAGE_INGEST_TOKEN=

# Each player gets an expressions session and, unless this is off, a vitals session.
# Each is its own process (~1/3 core, ~0.5 GB).
SPECTRA_VITALS=on
