# Only needed if you are NOT using the vite dev proxy (e.g. a built bundle served elsewhere).
# Leave both unset for local dev.
# VITE_API_BASE=http://localhost:8000/api
# VITE_WS_BASE=ws://localhost:8000/ws

# --- SmartSpectra vitals sidecar (frontend/src/smart-spectra/server.js) ---
# Where the browser opens its websocket to the node sidecar. Leave unset for local dev.
# VITE_SPECTRA_WS_URL=ws://localhost:3001
